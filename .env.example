# Explicit environment: development, staging, or production. Typos fail closed.
UPTICK_ENV=development
# Local-only PostgreSQL-compatible storage and preview identities. Never enable on Vercel.
UPTICK_LOCAL_MODE=true
LOCAL_DATABASE_PATH=.data/uptick
APP_URL=http://localhost:3000
# Production: managed Postgres URL (Supabase pooler, transaction mode; prepared statements disabled).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required production cryptographic keys. Generate each with openssl rand -hex 32.
PASS_ENCRYPTION_KEY=
SESSION_SECRET=
SMS_TRANSPORT=development
# A second independent gate for production delivery; staging always uses the allowlist.
PRODUCTION_DELIVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging service is configured per merchant in operator setup.
MESSAGING_APPROVED=false
LEGAL_APPROVED=false
SUPPORT_EMAIL=
BUSINESS_LEGAL_NAME=
CRON_SECRET=
# Set true only when your production reverse proxy overwrites x-real-ip with the
# real client address. Never forward a client-supplied value unchanged.
TRUST_PROXY_IP_HEADERS=false
# One-time administrator bootstrap only; create this actual Supabase Auth user first.
OPERATOR_AUTH_USER_ID=
OPERATOR_ORGANIZATION_NAME=

# Approved internal recipients only, comma-separated E.164 numbers.
# Empty means internal test sending is disabled.
INTERNAL_TEST_NUMBERS=

# Hosted staging workspaces require both actual Supabase sign-in and a live operator membership.
# Comma-separated Supabase Auth user IDs. Never use this to grant public access.
STAGING_TEST_USER_IDS=
